DJANGO_SECRET_KEY=django-insecure-change-me-in-production-abc123xyz
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# true = intentar seed al arrancar (solo aplica si la BD está vacía)
# false = nunca sembrar demos (recomendado en producción ya configurada)
SEED_DATA=true

DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# Ops (scripts/update.sh y scripts/backup-usb.sh)
# BACKUP_USB_MOUNT=/mnt/cloudpos-backup
# BACKUP_LOCAL_DIR=/opt/backups/cloudpos
# BACKUP_KEEP_DAYS=14
# UPDATE_BRANCH=main
